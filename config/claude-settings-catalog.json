      "id": "setting-model",
      "type": "setting",
      "section": "recommended",
      "key": "model",
      "label": "Default Model",
      "name": "Default Model",
      "description": "sonnet = cost-efficient (80%+ tasks), opus = deep reasoning, haiku = fastest",
      "scope": [
        "project",
        "local",
        "user",
        "managed"
      ],
      "writeTarget": ".claude/settings.json",
      "valuePath": "model",
      "settingKey": "model",
      "inputType": "select",
      "options": [
        "sonnet",
        "opus",
        "haiku"
      ],
      "example": "sonnet",
      "defaultValue": "sonnet",
      "priority": 1,
      "status": "synced",
      "docsUrl": "https://code.claude.com/docs/en/settings"
    },
    {
      "id": "setting-thinking-tokens",
